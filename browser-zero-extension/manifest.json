{
  "manifest_version": 3,
  "name": "Zero Browser Context",
  "version": "0.7.4",
  "description": "Send current page text to local Zero bridge and receive commands.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:4318/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send page to Zero",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "html2canvas.min.js",
        "html-to-image.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
